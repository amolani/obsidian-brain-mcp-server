{
  "name": "obsidian-brain-mcp-server",
  "version": "0.2.0",
  "description": "Second Brain MCP server for Obsidian vaults — filesystem-native, with automatic knowledge capture from Claude Code sessions.",
  "type": "module",
  "bin": {
    "obsidian-brain": "./cli.ts",
    "obsidian-brain-mcp": "./server.ts"
  },
  "files": [
    "cli.ts",
    "config.ts",
    "server-tools.ts",
    "server.ts",
    "suggestions.ts",
    "technik-categories.ts",
    "tool-handlers.ts",
    "vault.ts",
    "brain-policy.json",
    "CHANGELOG.md",
    "clients.json",
    "tag-aliases.json",
    "tech-terms.json",
    "technik-categories.json",
    ".env.example",
    "hooks/**/*.ts",
    "services/**/*.ts",
    "tool-handlers/**/*.ts",
    "tests/fixtures/brain-quality/*.json",
    "benchmarks/*.json",
    "demo/**",
    "docs/**",
    "assets/**",
    "plugins/claude-code/**"
  ],
  "scripts": {
    "start": "node server.ts",
    "test": "node --test --test-reporter=spec tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "brain-quality": "node cli.ts brain-quality",
    "benchmark": "node cli.ts benchmark --out /tmp/obsidian-brain-benchmark --notes 5000 --force",
    "release-check": "node cli.ts release-check"
  },
  "keywords": [
    "mcp",
    "obsidian",
    "knowledge-management",
    "second-brain",
    "claude-code"
  ],
  "license": "MIT",
  "author": "amolani",
  "repository": {
    "type": "git",
    "url": "https://github.com/amolani/obsidian-brain-mcp-server.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "yaml": "^2.7.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3"
  }
}
