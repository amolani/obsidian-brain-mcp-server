# Copy to .env (or set in your shell) and fill in your values
# Only VAULT_PATH is required; all others have sensible defaults.

VAULT_PATH=/absolute/path/to/your/obsidian/vault

# Required when this process is a dedicated blind reviewer. Run one isolated
# server/profile per registered reviewer. The server injects this identity and
# the judgement UTC timestamp; callers cannot select either through the public
# tool schemas. This is a process-bound pseudonym, not a human digital
# signature; regulated/published work needs an external credential layer.
# OBSIDIAN_BRAIN_MCP_MODE=calibration-review
# BRAIN_CALIBRATION_REVIEWER_ID=reviewer-a

# Required only for irreversible calibration campaigns. The anchor directory
# must be outside the vault and protected by independent append-only/WORM
# retention; a normal user-writable folder provides tamper evidence, not true
# irreversibility.
# BRAIN_CALIBRATION_ANCHOR_DIR=/absolute/path/to/independent/calibration-anchors
# BRAIN_CALIBRATION_VAULT_ID=my-stable-vault-id

# Optional — override config file locations
# CLIENTS_PATH=/absolute/path/to/clients.json
# TECHNIK_CATEGORIES_PATH=/absolute/path/to/technik-categories.json
# TAG_ALIASES_PATH=/absolute/path/to/tag-aliases.json
# TECH_TERMS_PATH=/absolute/path/to/tech-terms.json
# BRAIN_POLICY_PATH=/absolute/path/to/brain-policy.json

# Optional — override log/state locations (defaults under /tmp)
# HARVESTER_LOG=/tmp/knowledge-harvester.log
# HARVESTER_STATE_DIR=/tmp/knowledge-harvester-state
# HARVESTER_SUGGESTIONS_LOG=/tmp/knowledge-harvester-suggestions.log
# TECHNIK_SUGGESTIONS_LOG=/tmp/technik-suggestions.log
# SESSION_CHECKPOINT_STATE_DIR=/tmp/obsidian-brain-session-state
# SESSION_CHECKPOINT_LOG=/tmp/obsidian-brain-session-checkpoint.log
