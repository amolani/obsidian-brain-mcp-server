{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "*.ts",
    "hooks/**/*.ts",
    "services/**/*.ts",
    "tests/**/*.ts",
    "tool-handlers/**/*.ts"
  ]
}
